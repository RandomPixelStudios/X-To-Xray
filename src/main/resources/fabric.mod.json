{
	"schemaVersion": 1,
	"id": "xtoxray",
	"version": "${version}",
	"name": "XtoXray",
	"description": "Simple Xray mod for Minecraft.",
	"authors": [
		"Random Pixel Studios"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/x-to-xray",
		"sources": "https://modrinth.com/mod/x-to-xray"
	},
	"license": "Apache-2.0",
	"icon": "assets/xtoxray/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.xtoxray.XtoXray"
		],
		"client": [
			"com.xtoxray.client.XrayToggleHandler"
		]
	},
	"mixins": [
		{
			"config": "xtoxray.client.mixins.json",
			"environment": "client"
		},
		{
			"config": "xtoxray.sodium.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": ">=26.1 <26.5",
		"java": ">=25",
		"fabric-api": "*"
	}
}
